  .status-ok { color: #66ff66; background: #001a00; padding: 2px 8px; border-radius: 4px; border: 1px solid #66ff6644; }
  .status-warn { color: #ffaa44; background: #1a0a00; padding: 2px 8px; border-radius: 4px; border: 1px solid #ffaa4444; }
  .status-error { color: #ff4444; background: #1a0000; padding: 2px 8px; border-radius: 4px; border: 1px solid #ff222244; }
