  .metodo.get { color: #4a9eff; background: #001020; border-color: #4a9eff; }
  .ruta { color: #ffffff; font-family: 'Courier New', monospace; font-weight: bold; }
  .descripcion { color: #cccccc; font-size: 0.92em; margin-top: 4px; }
  hr { border: 0; border-top: 1px solid #333333; margin: 40px 0; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0; }
  @media (max-width: 800px) { .grid-2 { grid-template-columns: 1fr; } }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.85em; font-weight: bold; margin: 2px 4px 2px 0; }
  .badge-azul { background: #001a3a; color: #4a9eff; border: 1px solid #4a9eff; }
  .badge-rojo { background: #1a0000; color: #ff4444; border: 1px solid #ff2222; }
  .badge-verde { background: #001a00; color: #66ff66; border: 1px solid #66ff66; }
