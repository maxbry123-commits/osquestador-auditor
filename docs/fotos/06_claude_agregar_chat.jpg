  pre { background: #000000; color: #ffffff; padding: 18px; border-radius: 6px; overflow-x: auto; border-left: 4px solid #4a9eff; margin: 12px 0; font-family: 'Courier New', monospace; font-size: 0.92em; }
  pre.rojo { border-left: 4px solid #ff2222; }
  pre .c-azul { color: #4a9eff; }
