# agentmemory V4 — Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env to version control.

# Required: OpenAI API key
# Used for the GPT-4o judge in benchmark evaluation.
OPENAI_API_KEY=your-openai-api-key-here

# Required for Claude generation (world record configuration uses Claude Opus 4.6)
# Not needed if running with --gen-model gpt-4o instead.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
